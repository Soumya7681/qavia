{
  "name": "qavia-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen": "openapi-typescript ../api/openapi/qavia.yaml -o src/lib/api/schema.d.ts",
    "test": "vitest",
    "dev:mock": "NEXT_PUBLIC_API_BASE_URL=http://localhost:4010 next dev",
    "e2e": "playwright test",
    "mock": "prism mock ../api/openapi/qavia.yaml --port 4010"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@stoplight/prism-cli": "^5.16.0",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "^10",
    "happy-dom": "^20.14.5",
    "jsdom": "^30.1.2",
    "msw": "^3.0.2",
    "openapi-sampler": "^1.7.6",
    "openapi-typescript": "^7.9.1",
    "prettier": "^3",
    "shadcn": "^4.21.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.104.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "eventsource-parser": "^4.1.1",
    "lucide-react": "^1.52.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "openapi-fetch": "^0.17.0",
    "openapi-react-query": "^0.5.4",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.89.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "packageManager": "pnpm@10.33.0"
}
