# Qavia bootstrap environment.
#
# These are the ONLY environment variables the platform reads. Everything else
# is a setting in the database, edited from the UI, resolved
# user -> project -> global -> default (requirements.md 5.1).
#
# Adding a seventh variable to this file is a design error until proven
# otherwise. The question to answer is "why can this not be a UI setting?", and
# the only acceptable answers are: it is needed before the database is
# reachable, or it decrypts the settings themselves.

# Settings live in the database. Nothing can be read without this.
# Ports match infra/docker/compose.yaml, which is deliberately off the defaults
# so the stack coexists with a locally installed Postgres or Redis.
DATABASE_URL=postgres://qavia:qavia@localhost:55432/qavia?sslmode=disable

# The queue must connect before any job, including settings-dependent ones.
REDIS_URL=redis://localhost:56379/0

# Secrets in the settings table are encrypted with this. It cannot be stored in
# the thing it decrypts. Must be 32 random bytes, base64 encoded:
#   openssl rand -base64 32
# Losing it makes every stored secret unrecoverable and they must be re-entered.
APP_ENCRYPTION_KEY=REPLACE_ME_WITH_openssl_rand_base64_32

# Needed to build absolute links in emails sent before an admin has visited
# settings.
APP_URL=http://localhost:3000

# Process bootstrap.
PORT=8080
APP_ENV=development
